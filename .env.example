PORT=8788
# 可选：本机默认使用系统用户数据目录；云端默认 data/。相对路径以项目根目录为准。
# TIBO_DATA_DIR=/your/data/directory
# 正式部署填外部 HTTPS 地址，不带末尾斜线。凭证只留在服务器。
PUBLIC_ORIGIN=http://localhost:8788
X_BEARER_TOKEN=
# 专用于本站的 X Developer App；会创建 from:thsottiaux 的 stream rule。
X_HANDLE=thsottiaux
# auto: 无 Token 时用公共源；public: 始终免登录检查；api: 仅官方 API。
SOURCE_MODE=auto
# 本机页面「数据来源与后台状态 → 配置数据来源」保存后立即生效，
# local-sources.json 中的来源设置优先于此文件；云部署仍使用本文件。
PUBLIC_FEED_URL=https://codex-reset.com/api/feed
# 可选：最多两个经过验证的独立备用帖子源，逗号分隔；需要与主源相同的 JSON 结构。
# 默认不接入未经验证的镜像。主源故障/过期才尝试备用，各源独立遵守限流。
PUBLIC_FEED_FALLBACK_URLS=
# smart: 平时约 5 分钟，新预告后约 2 分钟；fast/standard/saver: 2/5/15 分钟。
# 本机页面保存的选择优先；支持约 10% 错峰、失败退避，最短 120 秒。
PUBLIC_POLL_MODE=smart
# 兼容旧 PUBLIC_POLL_SECONDS 设置，映射到预设；新配置请使用 PUBLIC_POLL_MODE。
# npm run keys 生成一对，所有实例必须保持一致，不要每次重启重新生成。
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@example.com
# 社区观测源：逗号分隔的 HTTPS JSON 地址，默认留空即关闭。
# 返回格式见 README「社区观测源」。程序不内置也不抓取任何第三方站点。
OBSERVATION_SOURCES=
