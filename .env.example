PORT=8788
# 正式部署填外部 HTTPS 地址，不带末尾斜线。凭证只留在服务器。
PUBLIC_ORIGIN=http://localhost:8788
X_BEARER_TOKEN=
# 专用于本站的 X Developer App；会创建 from:thsottiaux 的 stream rule。
X_HANDLE=thsottiaux
# npm run keys 生成一对，所有实例必须保持一致，不要每次重启重新生成。
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@example.com
# 社区观测源：逗号分隔的 HTTPS JSON 地址，默认留空即关闭。
# 返回格式见 README「社区观测源」。程序不内置也不抓取任何第三方站点。
OBSERVATION_SOURCES=
